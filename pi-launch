#!/usr/bin/env python3
import argparse
import json
import os
import shutil
import subprocess
import sys
from pathlib import Path

# Standard locations
CONFIG_DIR = Path.home() / ".config" / "pi-launcher"
CONFIG_FILE = CONFIG_DIR / "config.json"
ENV_FILE = CONFIG_DIR / ".env"


def load_config():
    if not CONFIG_FILE.exists():
        print(
            f"Error: Launcher configuration not found at {CONFIG_FILE}.",
            file=sys.stderr,
        )
        print(
            "Please run 'just install' from the pi-sandboxed-config directory to set it up.",
            file=sys.stderr,
        )
        sys.exit(1)
    try:
        with open(CONFIG_FILE, "r") as fd_config:
            return json.load(fd_config)
    except (json.JSONDecodeError, OSError) as err:
        print(f"Error reading configuration: {err}", file=sys.stderr)
        sys.exit(1)


def parse_env_file():
    if not ENV_FILE.exists():
        return {}

    def _parse_line(line):
        key, val = line.split("=", 1)
        return key.strip(), val.strip()

    with ENV_FILE.open("r") as fd:
        return dict(
            _parse_line(line)
            for line in fd
            if "=" in line and not line.strip().startswith("#")
        )


def check_macos_rosetta():
    """
    On macOS host, check if the running Podman machine has Rosetta translation active.
    Returns:
      True if Rosetta is enabled and active,
      False if Rosetta is disabled or binfmt is missing (falling back to QEMU),
      None if not running on macOS or check cannot be determined.
    """
    if sys.platform != "darwin":
        return None

    try:
        # Check machine configuration
        res = subprocess.run(
            ["podman", "machine", "inspect", "--format", "{{.Rosetta}}"],
            capture_output=True,
            text=True,
            check=False,
            timeout=4,
        )
        if res.returncode == 0:
            val = res.stdout.strip().lower()
            if val == "false":
                return False
            if val == "true":
                # Verify active binfmt registration in the VM
                ssh_res = subprocess.run(
                    ["podman", "machine", "ssh", "test -f /proc/sys/fs/binfmt_misc/rosetta"],
                    capture_output=True,
                    text=True,
                    check=False,
                    timeout=3,
                )
                return ssh_res.returncode == 0
    except (subprocess.SubprocessError, OSError):
        pass
    return None


def check_image_exists(image_name):
    try:
        res = subprocess.run(
            ["podman", "image", "exists", image_name],
            capture_output=True,
            check=False,
        )
        return res.returncode == 0
    except (subprocess.SubprocessError, OSError):
        return True


def get_existing_container_names():
    try:
        res = subprocess.run(
            ["podman", "ps", "-a", "--format", "{{.Names}}"],
            capture_output=True,
            text=True,
            check=True,
        )
        return set(res.stdout.strip().split())
    except (subprocess.SubprocessError, OSError):
        return set()


def resolve_container_name(base_name, existing_names):
    if base_name not in existing_names:
        return base_name
    counter = 2
    while f"{base_name}-{counter}" in existing_names:
        counter += 1
    return f"{base_name}-{counter}"


def get_git_ref(project_path):
    try:
        # First, try to get the symbolic branch name
        res = subprocess.run(
            ["git", "-C", str(project_path), "symbolic-ref", "--quiet", "--short", "HEAD"],
            capture_output=True,
            text=True,
            check=False,
        )
        branch = res.stdout.strip()
        if res.returncode == 0 and branch:
            return branch

        # If detached HEAD, get the 8-character commit hash
        res = subprocess.run(
            ["git", "-C", str(project_path), "rev-parse", "--short=8", "HEAD"],
            capture_output=True,
            text=True,
            check=False,
        )
        commit_hash = res.stdout.strip()
        if res.returncode == 0 and commit_hash:
            return commit_hash
        return None
    except (subprocess.SubprocessError, OSError):
        return None


def get_git_ro_mounts(project_path):
    """
    Mount Git metadata read-only (:ro,z) to allow live inspection of HEAD,
    branch, and commit hash without granting write permission to Git history.
    """
    git_indicator = project_path / ".git"
    if not git_indicator.exists():
        return []

    mounts = []
    if git_indicator.is_dir():
        # Standard repository: protect .git by mounting it read-only over rw /workspace
        mounts.extend(["-v", f"{git_indicator}:/workspace/.git:ro,z"])
    elif git_indicator.is_file():
        # Git worktree: mount the worktree gitdir and common gitdir read-only
        try:
            content = git_indicator.read_text().strip()
            if content.startswith("gitdir: "):
                raw_path = content[8:].strip()
                worktree_git_dir = (project_path / raw_path).resolve()
                if worktree_git_dir.exists():
                    mounts.extend(["-v", f"{worktree_git_dir}:{worktree_git_dir}:ro,z"])
                    commondir_file = worktree_git_dir / "commondir"
                    if commondir_file.exists():
                        common_rel = commondir_file.read_text().strip()
                        main_git_dir = (worktree_git_dir / common_rel).resolve()
                        if main_git_dir.exists():
                            mounts.extend(["-v", f"{main_git_dir}:{main_git_dir}:ro,z"])
        except OSError:
            pass
    return mounts


def ensure_git_worktree(repo_path, project_dir):
    project_path = Path(project_dir).resolve()

    # Create directory if it doesn't exist
    if not project_path.exists():
        print(f"Creating project directory: {project_path}")
        project_path.mkdir(parents=True)

    # Check if the directory is already a git worktree or repo
    git_indicator = project_path / ".git"
    if git_indicator.exists():
        print(f"Found existing Git workspace at {project_path}")
        return

    # If directory exists but is not empty and not a git repo, raise warning
    if any(project_path.iterdir()):
        print(
            f"Warning: Directory {project_path} is not empty and not a Git worktree. Skipping worktree creation.",
            file=sys.stderr,
        )
        return

    # Create worktree using Git
    print(f"Checking out a new Git worktree at {project_path}...")
    try:
        subprocess.run(
            [
                "git",
                "-C",
                str(repo_path),
                "worktree",
                "add",
                "--detach",
                str(project_path),
                "HEAD",
            ],
            check=True,
        )
        print("Successfully created Git worktree!")
    except subprocess.CalledProcessError as err:
        print(f"Error creating Git worktree: {err}", file=sys.stderr)
        sys.exit(1)


def main():
    parser = argparse.ArgumentParser(
        usage="pi-launch [options] [-- pi_options_and_args]",
        description="Launch pi-coding-agent inside a secure Podman sandbox.",
        formatter_class=argparse.RawDescriptionHelpFormatter,
        epilog="""
Usage examples:
  pi-launch                               # Launches in current directory
  pi-launch -a                            # Launches amd64 container under Rosetta emulation
  pi-launch -C                            # Launches with nested container support enabled
  pi-launch -r                            # Resumes last session in current directory
  pi-launch -p ~/projects/my-analysis     # Launches in specific directory
  pi-launch -a -p ~/projects/my-analysis  # Launches amd64 container in specific directory
  pi-launch -p ~/projects/my-analysis -r  # Resumes in specific directory
  pi-launch -i /path/to/readonly/data     # Launches mounting a read-only inspect folder
  pi-launch -- --offline                  # Forwards options after -- directly to pi
  pi-launch -i /data1 -i /data2           # Launches mounting multiple inspect folders
        """,
    )

    parser.add_argument(
        "-p",
        "--project-dir",
        default=".",
        help="Path to the writeable project workspace on the host. Defaults to current directory. Will be created as a Git worktree if not present.",
    )

    parser.add_argument(
        "-c",
        "--gcp-creds",
        help="Path to the Google Vertex service account key (.json) file. Defaults to value in global configuration.",
    )

    parser.add_argument(
        "-r",
        "--resume",
        action="store_true",
        help="Resume a previous Pi session inside this workspace.",
    )

    parser.add_argument(
        "-n",
        "--name",
        help="Custom container name. Defaults to 'pi-{project_name}', auto-incrementing with a numeric suffix (e.g. -2, -3) if already running.",
    )

    parser.add_argument(
        "-i",
        "--inspect",
        action="append",
        default=[],
        help="Paths to read-only directories on the host to mount under /inspect/ inside the sandbox (can be specified multiple times).",
    )

    parser.add_argument(
        "-a",
        "--amd64",
        action="store_true",
        help="Launch using the amd64 container image (pi-sandbox:amd64) under Rosetta emulation.",
    )

    parser.add_argument(
        "-C",
        "--nested-containers",
        "--podman",
        dest="nested_containers",
        action="store_true",
        help="Enable nested rootless Podman inside the sandbox (mounts /dev/fuse and unmasks /proc).",
    )

    # Pre-process arguments to separate launcher options from extra Pi options
    # strictly after a mandatory '--' separator.
    raw_args = sys.argv[1:]
    if "--" in raw_args:
        idx = raw_args.index("--")
        launcher_args, pi_forward_args = raw_args[:idx], raw_args[idx + 1 :]
    else:
        launcher_args, pi_forward_args = raw_args, []

    # Parse only launcher_args; unrecognized options will trigger a standard error
    args = parser.parse_args(launcher_args)

    # Verify Podman is installed
    if not shutil.which("podman"):
        print(
            "Error: 'podman' executable not found. This launcher requires Podman to run.",
            file=sys.stderr,
        )
        sys.exit(1)

    # Load launcher configurations
    config = load_config()
    repo_path = Path(config["repo_path"])

    # Resolve GCP Credentials cleanly with chained fallback
    gcp_creds_path = (
        args.gcp_creds
        or config.get("default_credentials_json")
        or os.getenv("GOOGLE_APPLICATION_CREDENTIALS")
    )

    if not gcp_creds_path:
        print(
            "Error: Google Application Credentials (.json) path must be specified.",
            file=sys.stderr,
        )
        print(
            "Use the -c/--gcp-creds flag, set GOOGLE_APPLICATION_CREDENTIALS, or configure it in config.json.",
            file=sys.stderr,
        )
        sys.exit(1)

    gcp_creds_path = Path(gcp_creds_path).resolve()
    if not gcp_creds_path.exists():
        print(
            f"Error: Google credentials file not found at {gcp_creds_path}",
            file=sys.stderr,
        )
        sys.exit(1)

    # Ensure project workspace has a git worktree of the config
    ensure_git_worktree(repo_path, args.project_dir)
    project_path = Path(args.project_dir).resolve()

    # Warn if amd64 requested on macOS without active Rosetta support
    if args.amd64:
        rosetta_status = check_macos_rosetta()
        if rosetta_status is False:
            print(
                "\n⚠️  Warning: Podman machine does not have Rosetta active for amd64 emulation.",
                file=sys.stderr,
            )
            print(
                "   amd64 containers will fall back to QEMU emulation, which is significantly slower.",
                file=sys.stderr,
            )
            print(
                "   To enable Rosetta, configure ~/.config/containers/containers.conf on your Mac:",
                file=sys.stderr,
            )
            print("     [machine]", file=sys.stderr)
            print("     provider = \"applehv\"", file=sys.stderr)
            print("     rosetta = true", file=sys.stderr)
            print(
                "   Or edit ~/.config/containers/podman/machine/applehv/<name>.json to set \"Rosetta\": true\n",
                file=sys.stderr,
            )

    # Determine container image and verify existence for amd64
    image_name = "pi-sandbox:amd64" if args.amd64 else "pi-sandbox"
    if args.amd64 and not check_image_exists(image_name):
        print(
            f"Error: Container image '{image_name}' not found.",
            file=sys.stderr,
        )
        print(
            "Please run 'just build-amd64' from the pi-sandboxed-config repository first.",
            file=sys.stderr,
        )
        sys.exit(1)

    # Read environment variables from global config .env file
    env_vars = parse_env_file()

    # Build container execution command
    existing_containers = get_existing_container_names()
    base_name = f"pi-{project_path.name}"
    if args.amd64:
        base_name = f"{base_name}-amd64"
    default_name = base_name
    requested_name = args.name or default_name
    container_name = resolve_container_name(requested_name, existing_containers)

    # Base Podman run structure
    podman_cmd = [
        "podman",
        "run",
        "--rm",
        "-it",
        "--name",
        container_name,
        "--hostname",
        container_name,
        # Map host user to container UID 1000 (pi) for perfect permission parity
        "--userns=keep-id:uid=1000,gid=1000",
        # In-memory transient directories
        "--tmpfs",
        "/tmp",
        "--tmpfs",
        "/home/pi:U",
        # Writeable workspace directory (rw, shared SELinux label enabled)
        "-v",
        f"{project_path}:/workspace:rw,z",
        # Google credential JSON key mounted read-only
        "-v",
        f"{gcp_creds_path}:/secrets/gcp-credentials.json:ro,z",
        "-e",
        "GOOGLE_APPLICATION_CREDENTIALS=/secrets/gcp-credentials.json",
        "-e",
        f"CONTAINER_NAME={container_name}",
        "-e",
        f"PI_CONTAINER_NAME={container_name}",
    ]

    # Target amd64 platform under emulation if requested
    if args.amd64:
        podman_cmd += ["--platform", "linux/amd64"]

    # Enable nested rootless Podman inside the sandbox if requested
    if args.nested_containers:
        # On native Linux hosts, verify that /dev/fuse is available.
        # On macOS, Podman runs inside a Linux VM (podman-machine) which provides /dev/fuse natively.
        if sys.platform.startswith("linux") and not Path("/dev/fuse").exists():
            print(
                "Warning: /dev/fuse device not found on host. Nested containers require FUSE.",
                file=sys.stderr,
            )
            print(
                "Ensure the fuse module is loaded on the host (e.g. 'sudo modprobe fuse').",
                file=sys.stderr,
            )
        podman_cmd += [
            "--device",
            "/dev/fuse",
            "--security-opt",
            "label=disable",
            "--security-opt",
            "unmask=/proc/*",
        ]

    # Mount Git metadata read-only for live branch/commit inspection without write permissions
    podman_cmd += get_git_ro_mounts(project_path)

    # Inject current Git branch or 8-character commit hash if in a repository
    git_ref = get_git_ref(project_path)
    if git_ref:
        podman_cmd += ["-e", f"GIT_BRANCH={git_ref}", "-e", f"GIT_REF={git_ref}"]

    # Mount project-local models.json if it exists in .pi/models.json
    local_models_path = project_path / ".pi" / "models.json"
    if local_models_path.exists():
        podman_cmd += ["-v", f"{local_models_path}:/home/pi/.pi/agent/models.json:ro,z"]

    # Mount inspect (read-only) directories if provided under /inspect/<basename>
    mounted_names = set()
    for inspect_dir in args.inspect:
        inspect_path = Path(inspect_dir).resolve()
        if not inspect_path.exists():
            print(
                f"Error: Inspect directory does not exist: {inspect_path}",
                file=sys.stderr,
            )
            sys.exit(1)

        basename = inspect_path.name
        target_name = basename
        counter = 1
        while target_name in mounted_names:
            target_name = f"{basename}_{counter}"
            counter += 1
        mounted_names.add(target_name)

        podman_cmd += ["-v", f"{inspect_path}:/inspect/{target_name}:ro,z"]

    # Inject parsed environment variables
    for key, val in env_vars.items():
        podman_cmd += ["-e", f"{key}={val}"]

    # Append image name
    podman_cmd += [image_name]

    # Append pi command arguments
    # Automatically add '--approve' so pi trusts our project workspace directory (/workspace) on boot
    podman_cmd += ["--approve"]

    # Provide session display name matching container name unless already provided
    if not any(arg in pi_forward_args for arg in ("--name", "-n")):
        podman_cmd += ["--name", container_name]

    if args.resume:
        podman_cmd += ["-r"]

    if pi_forward_args:
        podman_cmd += pi_forward_args

    print("\n" + "=" * 60)
    print(f"Launching sandboxed Pi container: '{container_name}'")
    print(f"Workspace: {project_path}")
    if args.amd64:
        print("Architecture: amd64 (Rosetta/emulated)")
    if args.nested_containers:
        print("Nested containers: Enabled (/dev/fuse, unmasked /proc)")
    print(
        f"Run 'just root {container_name}' in another terminal for root shell access."
    )
    print("=" * 60 + "\n")

    try:
        # Execute Podman running in foreground
        subprocess.run(podman_cmd, check=True)
    except subprocess.CalledProcessError as err:
        # Silent ignore of Ctrl+C exits or clean exits
        sys.exit(err.returncode)
    except KeyboardInterrupt:
        print("\nSession exited.")
        sys.exit(0)


if __name__ == "__main__":
    main()
